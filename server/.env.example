PORT=8080
SUPABASE_URL=
# Verify access tokens (pick one or more):
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
# Persistence (PR #60). Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated browser origins. Empty allows all (local dev).
ALLOWED_ORIGINS=
# Local smoke tests only. Accepts tokens of the form dev:<uuid> or dev:<uuid>:Name
ALLOW_DEV_TOKENS=
