PORT=8080
SUPABASE_URL=
# Verify access tokens (pick one or more):
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
# Persistence (PR #60). Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated browser origins. Empty allows all (local dev).
# Comma-separated browser origins for CORS and WebSocket checks.
ALLOWED_ORIGINS=https://monstergate.online,http://monstergate.online,https://www.monstergate.online,https://machine10101-vibes.github.io
# Local smoke tests only. Accepts tokens of the form dev:<uuid> or dev:<uuid>:Name
ALLOW_DEV_TOKENS=
# Max hunters in one place name. Default 150. 0 = no cap.
ZONE_CAP=
