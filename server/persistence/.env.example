# World-server character persistence. Never commit real keys.
# The service role key bypasses RLS and is the only writer for public.characters.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. memory | noop | supabase (default: supabase when URL+key are set, else memory)
# MG_PERSISTENCE_ADAPTER=memory
